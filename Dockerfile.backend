# Multi-stage build for WebSocket Collaborative Server with Security & Monitoring
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies (including security & monitoring packages)
RUN npm ci --only=production

# Copy application files
COPY modules/ ./modules/
COPY scripts/ ./scripts/
COPY .env.example ./.env.example

# Create logs directory and non-root user
RUN mkdir -p logs && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Health check using HTTP endpoint
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8765/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); });" || exit 1

# Expose WebSocket port
EXPOSE 8765

# Start production server with security and monitoring
CMD ["node", "scripts/production-server.js", "8765"]
