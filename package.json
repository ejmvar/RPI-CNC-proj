{
  "name": "rpi-cnc-proj",
  "version": "0.1.0",
  "private": true,
  "description": "Raspberry Pi CNC simulator — lightweight frontend and tooling",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=tests/e2e --maxWorkers=4",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --testPathIgnorePatterns=tests/e2e --maxWorkers=4",
    "lint": "eslint . --ext .js,.mjs || true",
    "format": "prettier --write .",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/ut --maxWorkers=4",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/it --maxWorkers=4",
    "test:e2e": "node --experimental-vm-modules node_modules/.bin/jest tests/e2e --runInBand",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "eslint": "^8.46.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.6.1",
    "jest-image-snapshot": "^6.0.0",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.39.1",
    "prettier": "^2.8.8",
    "ws": "^8.13.0"
  }
}
