{
  "name": "rpi-cnc-proj",
  "version": "0.1.0",
  "private": true,
  "description": "Raspberry Pi CNC simulator — lightweight frontend and tooling",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=tests/e2e --testPathIgnorePatterns=tests/visual --maxWorkers=4",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --testPathIgnorePatterns=tests/e2e --testPathIgnorePatterns=tests/visual --maxWorkers=4",
    "lint": "eslint . --ext .js,.mjs || true",
    "format": "prettier --write .",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/ut --maxWorkers=4",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/it --maxWorkers=4",
    "test:e2e": "node --experimental-vm-modules node_modules/.bin/jest tests/e2e --runInBand",
    "test:visual": "node --experimental-vm-modules node_modules/.bin/jest tests/visual/specs --runInBand --testTimeout=60000",
    "test:visual:update": "UPDATE_SNAPSHOTS=1 npm run test:visual",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@jest/globals": "^30.2.0",
    "@types/three": "^0.182.0",
    "eslint": "^8.46.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.6.1",
    "jest-image-snapshot": "^6.0.0",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.39.1",
    "pngjs": "^7.0.0",
    "prettier": "^2.8.8",
    "puppeteer": "^24.33.0",
    "ws": "^8.13.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "winston": "^3.11.0"
  }
}
