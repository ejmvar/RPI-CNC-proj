{
  "name": "rpi-cnc-proj",
  "version": "0.1.0",
  "private": true,
  "description": "Raspberry Pi CNC simulator — lightweight frontend and tooling",
  "scripts": {
    "test": "jest --runInBand",
    "lint": "eslint . --ext .js,.mjs || true",
    "format": "prettier --write .",
    "test:unit": "jest tests/ut --runInBand",
    "test:integration": "jest tests/it --runInBand",
    "test:e2e": "jest tests/e2e --runInBand",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^8.46.0",
    "husky": "^9.1.7",
    "jest": "^29.6.1",
    "jest-image-snapshot": "^6.0.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.39.1",
    "prettier": "^2.8.8",
    "ws": "^8.13.0"
  }
}
